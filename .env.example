# Copie para .env e ajuste os valores (o .env não vai para o git)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# URL do Odoo que recebia o webhook do Bitrix (o worker repassa para ela).
# É a mesma URL que estava configurada no webhook de saída do Bitrix.
ODOO_WEBHOOK_URL=https://seu-odoo.com.br/api/bitrix/post_crm_bitrix
ODOO_TIMEOUT_SECONDS=30
# Tentativas extras (a cada 30s) quando o Odoo estiver fora, antes de ir para a DLQ
ODOO_MAX_RETRIES=5
